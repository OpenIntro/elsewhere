# Copy to .env (never commit .env). All values optional.
# HTTP + WebSocket port (game client, REST API and Colyseus share it).
PORT=2567
# Directory for local persistence (JSON/SQLite files, owned by server/src/persistence).
DATA_DIR=./data
# Secret used to sign session tokens. REQUIRED in production; dev falls back to an insecure default.
SESSION_SECRET=
# Optional: override the length of a full in-world day, in minutes.
DAY_LENGTH_MINUTES=48
# Dev only: port the Vite dev client uses to reach the server.
VITE_SERVER_PORT=2567
