# Copy to .env in the repo root (never commit .env). The server loads it at boot; variables
# already set in the real environment take precedence. All values optional in development.

# --- Server ------------------------------------------------------------------
# HTTP + WebSocket port (game client, REST API and Colyseus share it).
PORT=2567
# development | production. In production SESSION_SECRET (>= 32 chars) is required.
# NODE_ENV=production
# Built client directory to serve (default: <repo>/client/dist).
CLIENT_DIST=
# Set to 1 behind a reverse proxy so per-IP rate limits use X-Forwarded-For.
TRUST_PROXY=
# Set to 1 for extra server diagnostics (e.g. logs every refused out-of-range interaction).
ELSEWHERE_DEBUG=

# --- Persistence -------------------------------------------------------------
# Real Postgres / Supabase connection string. When unset, embedded PGlite is used.
# e.g. postgres://user:pass@host:5432/elsewhere  (Supabase: use the pooler URL, sslmode=require)
DATABASE_URL=
# Directory for local persistence (PGlite database lives in $DATA_DIR/pglite).
# Default: <repo>/server/data (gitignored). Relative paths resolve against the server's working directory.
DATA_DIR=

# --- Auth --------------------------------------------------------------------
# HMAC secret for session tokens. REQUIRED in production (>= 32 random chars); dev falls back to an insecure default.
SESSION_SECRET=
# Enables admin REST tools (/api/admin/*) when set (>= 16 chars). Send as "Authorization: Bearer <ADMIN_TOKEN>".
ADMIN_TOKEN=
# Optional Supabase Auth: accept Supabase access tokens as session tokens.
# HS256 projects: the project's JWT secret. Asymmetric (RS256/ES256) projects: set SUPABASE_URL (JWKS is fetched).
SUPABASE_JWT_SECRET=
SUPABASE_URL=

# --- World -------------------------------------------------------------------
# Length of a full in-world day, in real minutes (the clock epoch is persisted; changing this keeps the current time of day).
DAY_LENGTH_MINUTES=48
# How often a Gazette issue is compiled (real minutes). Default 360.
GAZETTE_INTERVAL_MINUTES=360
# Young world: until the first issue exists, publish it this many seconds after this many significant real events.
GAZETTE_EARLY_EVENTS=3
GAZETTE_EARLY_DELAY_SECONDS=60

# Collective Reality overrides (defaults live in shared/src/config.ts CONFIG.collective).
# Small values make the rules triggerable by two testers.
# Fountain: contributions per stage (one per player per world-day) and minimum distinct players per stage.
FOUNTAIN_STAGES=
FOUNTAIN_STAGE_DISTINCT=
# Portal: distinct players who must light different rune stones at the same time (default 2, min 1).
PORTAL_RUNES_REQUIRED=
# How long a lit rune stays lit (ms) / how long the portal stays awake (ms).
PORTAL_WINDOW_MS=
PORTAL_AWAKE_MS=
# Distinct players ringing the bell within the chorus window for its other voice (min 2).
BELL_CHORUS_PLAYERS=
# Players in one place that count as a gathering.
GATHERING_THRESHOLD=

# Building activities (defaults in shared/src/config.ts CONFIG.activities).
# Café: minutes a drink lasts in hand (default 4).
DRINK_MINUTES=
# General Store: free curiosities one player may take per world-day (default 1).
STORE_TAKES_PER_DAY=
# Town Hall notice board: notices one player may have up at once (default 2) and how long they stay up (hours, default 72).
NOTICE_MAX_PER_PLAYER=
NOTICE_EXPIRY_HOURS=
# Town poll: world-days per poll question (default 1).
POLL_PERIOD_DAYS=
# Workshop town project: per stage, work needed and DISTINCT players needed (one entry per stage; default 6,10,14 / 2,3,4)
# and pieces of work one player may do per world-day (default 3).
WORKSHOP_STAGE_CONTRIBUTIONS=
WORKSHOP_STAGE_DISTINCT=
WORKSHOP_DAILY_CONTRIBUTIONS=
# Homes: minutes a lit hearth burns (default 20).
HEARTH_MINUTES=
# Boathouse: net sections per net (default 5; one mend per player per world-day).
NET_SECTIONS=

# Player building (defaults in shared/src/config.ts CONFIG.building / CONFIG.rateLimits.build).
# 0 or false switches building off (existing pieces stay and keep colliding).
BUILD_ENABLED=
# Max distance in metres from the builder to a piece's centre (default 9).
BUILD_RANGE=
# Pieces one profile may own at once (default 400) / pieces in one world (default 6000).
BUILD_MAX_PER_PLAYER=
BUILD_MAX_PER_WORLD=
# Per-profile token bucket for placing, removing, clearing and editing: burst size and refill per second (default 8 / 2).
BUILD_RATE_CAPACITY=
BUILD_RATE_PER_SECOND=
# Bushes / small rocks one profile may clear per real day (default 20).
BUILD_CLEAR_DAILY=
# Hours until a cleared bush / rock grows back, unless something is built within 1.5 m (default 24).
BUILD_REGROW_HOURS=

# --- Client dev ----------------------------------------------------------------
# Dev only: port the Vite dev client uses to reach the server (defaults to PORT, then 2567).
# Read by client/vite.config.ts from the shell environment, not from this file.
VITE_SERVER_PORT=
