# Copy to .env (never commit .env). All values optional in development.

# --- Server ------------------------------------------------------------------
# HTTP + WebSocket port (game client, REST API and Colyseus share it).
PORT=2567
# development | production. In production SESSION_SECRET (>= 32 chars) is required.
NODE_ENV=development
# Built client directory to serve (default: client/dist).
CLIENT_DIST=
# Set to 1 behind a reverse proxy so per-IP rate limits use X-Forwarded-For.
TRUST_PROXY=
# Set to 1 for extra server diagnostics (e.g. logs every refused out-of-range interaction).
ELSEWHERE_DEBUG=

# --- Persistence -------------------------------------------------------------
# Real Postgres / Supabase connection string. When unset, embedded PGlite is used.
# e.g. postgres://user:pass@host:5432/elsewhere  (Supabase: use the pooler URL, sslmode=require)
DATABASE_URL=
# Directory for local persistence (PGlite database lives in $DATA_DIR/pglite). Gitignored.
DATA_DIR=./data

# --- Auth --------------------------------------------------------------------
# HMAC secret for session tokens. REQUIRED in production (>= 32 random chars); dev falls back to an insecure default.
SESSION_SECRET=
# Enables admin REST tools (/api/admin/*) when set (>= 16 chars). Send as "Authorization: Bearer <ADMIN_TOKEN>".
ADMIN_TOKEN=
# Optional Supabase Auth: accept Supabase access tokens as session tokens.
# HS256 projects: the project's JWT secret. Asymmetric (RS256/ES256) projects: set SUPABASE_URL (JWKS is fetched).
SUPABASE_JWT_SECRET=
SUPABASE_URL=

# --- World -------------------------------------------------------------------
# Length of a full in-world day, in real minutes (the clock epoch is persisted; changing this keeps the current time of day).
DAY_LENGTH_MINUTES=48
# How often a Gazette issue is compiled (real minutes). Default 360.
GAZETTE_INTERVAL_MINUTES=360
# Young world: until the first issue exists, publish it this many seconds after this many significant real events.
GAZETTE_EARLY_EVENTS=3
GAZETTE_EARLY_DELAY_SECONDS=60

# Collective Reality overrides (defaults live in shared/src/config.ts CONFIG.collective).
# Small values make the rules triggerable by two testers.
# Fountain: contributions per stage (one per player per world-day) and minimum distinct players per stage.
FOUNTAIN_STAGES=
FOUNTAIN_STAGE_DISTINCT=
# Portal: distinct players who must light different rune stones at the same time (default 2, min 1).
PORTAL_RUNES_REQUIRED=
# How long a lit rune stays lit (ms) / how long the portal stays awake (ms).
PORTAL_WINDOW_MS=
PORTAL_AWAKE_MS=
# Distinct players ringing the bell within the chorus window for its other voice (min 2).
BELL_CHORUS_PLAYERS=
# Players in one place that count as a gathering.
GATHERING_THRESHOLD=

# --- Client dev ----------------------------------------------------------------
# Dev only: port the Vite dev client uses to reach the server.
VITE_SERVER_PORT=2567
